// Configurazione del Worker «esplorazione» (fase 3 del piano).
// Pubblicato da Cloudflare Workers Builds a ogni push su `main`, con cartella radice `server/`.
// Indirizzo: https://esplorazione.artenaut.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esplorazione",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,

  // Una partita = un Durable Object «Partita» con SQLite (piano gratuito).
  "durable_objects": {
    "bindings": [{ "name": "PARTITA", "class_name": "Partita" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partita"] }],

  // Dati permanenti (esplorazioni; più avanti nickname, partite concluse, stagioni).
  // Senza database_id: wrangler crea il database alla prima pubblicazione e lo collega da solo.
  "d1_databases": [{ "binding": "DB", "database_name": "esplorazione" }],

  "vars": {
    // Origini da cui l'app può chiamare il server.
    "ORIGINI_CONSENTITE": "https://artenaut.github.io",
    // Cloudflare Access per l'area /admin: dominio del team e «Application Audience (AUD) Tag»
    // dell'applicazione Access. Finché l'AUD è vuoto, l'area admin risponde «non configurata».
    "ACCESS_TEAM": "artenaut.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },

  // Registri nel pannello Cloudflare: solo i messaggi scritti dal codice (errori),
  // non i dettagli di ogni richiesta, per non conservare indirizzi IP o altri dati.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
